{#{% extends viewbaseLayout is defined ? viewbaseLayout : '@ibexadesign/ui/layout.html.twig' %}#}
{% extends '@ibexadesign/ui/edit_base.html.twig' %}

{% form_theme form with '@SQLIEzToolbox/form_fields.html.twig' only %}

{% trans_default_domain 'sqli_admin' %}

{% block title %}{{ 'entity.creation.page.title'|trans|desc('Entity page title') }}{% endblock %}

{% block header %}
    <div class="ibexa-edit-header__containers">
        <div class="ibexa-edit-header__container ibexa-edit-header__container--info-bar">
            {% block breadcrumbs %}
                {% set keytrad = constant('SQLI\\EzToolboxBundle\\Menu\\MenuListener::SQLI_ADMIN_MENU_ENTITIES_TAB_PREFIX') ~ tabname %}
                {% include '@ibexadesign/ui/breadcrumbs.html.twig' with { items: [
                    { value: 'breadcrumb.admin'|trans(domain='messages')|desc('Admin') },
                    { value: keytrad|trans( {}, 'sqli_admin' )|desc('Entity'),
                        url: path( 'sqli_eztoolbox_entitymanager_homepage', { 'tabname': tabname } ) },
                    { value: fqcn,
                        url: path( 'sqli_eztoolbox_entitymanager_entity_homepage', { 'fqcn': fqcn } ) },
                    { value: 'entity.button.alt.create'|trans },
                ]} only %}
            {% endblock %}
        </div>
        <div class="ibexa-edit-header__container ibexa-edit-header__container--context-actions">
            <div class="ibexa-edit-header__context-actions hstack justify-content-end gap-3">
                {% set sidebar_right = knp_menu_get('sqli_eztoolbox.admin.edit_element.sidebar_right',
                    [],
                    {
                        'save_button_name': form.children.save_entity.vars.id,
                        'cancel_url': path( 'sqli_eztoolbox_entitymanager_entity_homepage',
                        { 'fqcn': fqcn } )
                    }
                ) %}
                {{ knp_menu_render(sidebar_right, {'template': '@ibexadesign/eztoolbox/menu/sidebar_right.html.twig'}) }}
            </div>
        </div>
        <div class="ibexa-edit-header__container ibexa-edit-header__container--details">
            <div class="ibexa-edit-header__title-section">
                <h1 class="ibexa-edit-header__title">
                    {{ 'entity.creation.page.title'|trans|desc('Entity page title') }}
                </h1>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_title %}
    {% include '@ibexadesign/ui/page_title.html.twig' with {
        title: 'entity.creation.page.title'|trans|desc('Entity page title'),
        icon_name: 'object-state'
    } %}
{% endblock %}

{% block content %}
    {% block left_sidebar %}
    {% endblock left_sidebar %}
    <div class="ibexa-edit-content__container">
        {{ form_start(form, {'attr': {'class': 'ibexa-form-validate'}}) }}

        {% for field in form.children %}
            {% if not field.rendered %}
                {{ form_row(field) }}
            {% endif %}
        {% endfor %}

        {{ form_end(form) }}
    </div>
    {% block right_sidebar_wrapper %}
    {% endblock %}
{% endblock %}
